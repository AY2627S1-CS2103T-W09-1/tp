<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <HBox spacing="6" alignment="TOP_LEFT" styleClass="card-header">
    <Label fx:id="id" styleClass="cell_big_label">
      <minWidth>
        <!-- Ensures that the label text is never truncated -->
        <Region fx:constant="USE_PREF_SIZE" />
      </minWidth>
    </Label>
    <Label fx:id="name" text="\$first" styleClass="cell_big_label" wrapText="true" />
  </HBox>

  <GridPane styleClass="card-sections">
    <columnConstraints>
      <ColumnConstraints percentWidth="33.34" />
      <ColumnConstraints percentWidth="33.33" />
      <ColumnConstraints percentWidth="33.33" />
    </columnConstraints>

    <VBox styleClass="card-section" spacing="2" GridPane.columnIndex="0" maxHeight="Infinity">
      <Label text="DETAILS" styleClass="card-section-caption" />
      <Label fx:id="phone" styleClass="cell_small_label" wrapText="true" text="\$phone" />
      <Label fx:id="email" styleClass="cell_small_label" wrapText="true" text="\$email" />
      <Label fx:id="address" styleClass="cell_small_label" wrapText="true" text="\$address" />
    </VBox>

    <VBox styleClass="card-section" spacing="2" GridPane.columnIndex="1" maxHeight="Infinity">
      <Label text="ATTRIBUTES" styleClass="card-section-caption" />
      <GridPane fx:id="attributes" hgap="10" vgap="1" />
    </VBox>

    <VBox styleClass="card-section, card-section-last" spacing="2" GridPane.columnIndex="2"
          maxHeight="Infinity">
      <Label text="PARTNER CRITERIA" styleClass="card-section-caption" />
      <Label text="Prefers" styleClass="card-subcaption" />
      <VBox fx:id="preferences" styleClass="card-criteria" />
      <Label text="Dealbreakers" styleClass="card-subcaption" />
      <VBox fx:id="dealbreakers" styleClass="card-criteria" />
    </VBox>
  </GridPane>

  <FlowPane fx:id="badges" styleClass="card-badges" hgap="5" vgap="3" alignment="CENTER_LEFT" />
</VBox>
