@startuml
!pragma layout smetana
!include style.puml
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor #F0F0FF
skinparam classBorderColor LOGIC_COLOR
skinparam classFontColor #202020
skinparam classAttributeFontColor #202020
skinparam classStereotypeFontColor #202020
skinparam nodesep 40
skinparam ranksep 50

package Logic as LogicPackage {
interface Logic <<interface>>
class LogicManager
class AddressBookParser
abstract class Command
class XYZCommand
class MatchCommand
class FindMatchCommand
class CommandResult
class MatchCommandResult
}

LogicManager .up.|> Logic
LogicManager -right-> "1" AddressBookParser : parses input
AddressBookParser ..> Command : returns
LogicManager .down.> Command : executes
Logic ..> CommandResult : returns
Command ..> CommandResult : returns
XYZCommand -up-|> Command
MatchCommand -up-|> Command
FindMatchCommand -up-|> Command
MatchCommandResult -up-|> CommandResult
MatchCommand ..> MatchCommandResult : creates

@enduml
