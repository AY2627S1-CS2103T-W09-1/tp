@startuml
!pragma layout smetana
!include style.puml
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor #FFF5F6
skinparam classBorderColor MODEL_COLOR
skinparam classFontColor #202020
skinparam classAttributeFontColor #202020
skinparam classStereotypeFontColor #202020
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 50

package Model as ModelPackage {
interface ReadOnlyAddressBook <<interface>>
interface ReadOnlyUserPrefs <<interface>>
interface Model <<interface>>
class AddressBook
class ModelManager
class UserPrefs
class UniquePersonList
class Person
class ClientGroup
class GroupName
class DatingCriteria {
    -preferences: Map<DatingAttribute, Set<String>>
    -dealbreakers: Map<DatingAttribute, Set<String>>
}
}

ModelManager .up.|> Model
Model .left.> ReadOnlyAddressBook
Model .right.> ReadOnlyUserPrefs
AddressBook .up.|> ReadOnlyAddressBook
UserPrefs .up.|> ReadOnlyUserPrefs
ModelManager -down-> "1" AddressBook
ModelManager -right-> "1" UserPrefs
AddressBook *-down-> "1" UniquePersonList
AddressBook *-right-> "*" ClientGroup
ClientGroup -down-> "1" GroupName
ClientGroup --> "0..*" Person : members
UniquePersonList -down-> "0..*" Person : all clients
Person -down-> "1" DatingCriteria : datingCriteria

show DatingCriteria fields
@enduml
