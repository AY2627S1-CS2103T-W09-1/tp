@startuml
!pragma layout smetana
!include style.puml
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor #F0FFF0
skinparam classBorderColor UI_COLOR_T4
skinparam classFontColor #202020
skinparam classAttributeFontColor #202020
skinparam classStereotypeFontColor #202020
skinparam nodesep 45
skinparam ranksep 55

package UI as UiPackage {
interface Ui <<interface>>
class UiManager
class MainWindow
class HelpWindow
class CommandBox
class ResultDisplay
class PersonListPanel
class StatusBarFooter
class MatchResultView
}

interface "Logic" as LogicApi <<interface>> LOGIC_COLOR_T1

UiManager .up.|> Ui
UiManager -down-> "1" MainWindow
UiManager -right-> "1" LogicApi
MainWindow -right-> "1" LogicApi
MainWindow -down-> "1" HelpWindow
MainWindow *-down-> "1" CommandBox
MainWindow *-down-> "1" ResultDisplay
MainWindow *-down-> "1" PersonListPanel
MainWindow *-down-> "1" StatusBarFooter
ResultDisplay .down.> MatchResultView : creates
@enduml
