@startuml
!pragma layout smetana
!include style.puml
skinparam dpi 150
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR
skinparam nodesep 60
skinparam ranksep 75
skinparam ArrowFontStyle plain

package UI <<Rectangle>> {
    Class "<<interface>>\nUi" as Ui
    Class "{abstract}\nUiPart" as UiPart
    Class UiManager
    Class MainWindow
    Class HelpWindow
    Class CommandBox
    Class "<<interface>>\nCommandBox.CommandExecutor" as CommandExecutor
    Class ResultDisplay
    Class MatchResultView
    Class PersonListPanel
    Class "PersonListPanel.\nPersonListViewCell" as PersonListViewCell
    Class PersonCard
    Class StatusBarFooter
}

package Logic as LogicPackage LOGIC_COLOR_T1 {
    Class "<<interface>>\nLogic" as LogicApi LOGIC_COLOR
}

package Model MODEL_COLOR_T1 {
}

package JavaFX #EEEEEE {
    Class ScrollPane #666666
    Class ListCell #666666
}

UiManager .up.|> Ui
UiManager -down-> "1" MainWindow
MainWindow *-down-> "1" CommandBox
MainWindow *-down-> "1" ResultDisplay
MainWindow *-down-> "1" PersonListPanel
MainWindow *-down-> "1" StatusBarFooter
MainWindow -right-> "1" HelpWindow

CommandBox -down-> "1" CommandExecutor
MainWindow ..> CommandExecutor : supplies callback
ResultDisplay .down.> MatchResultView : <<create>>
PersonListPanel .down.> PersonListViewCell : <<create>>
PersonListViewCell .down.> PersonCard : <<create>>

MainWindow --|> UiPart
HelpWindow --|> UiPart
CommandBox --|> UiPart
ResultDisplay --|> UiPart
PersonListPanel --|> UiPart
PersonCard --|> UiPart
StatusBarFooter --|> UiPart
MatchResultView --|> ScrollPane
PersonListViewCell --|> ListCell

UiManager -left-> "1" LogicApi
MainWindow -left-> "1" LogicApi

CommandBox .[norank].> LogicPackage
CommandExecutor .[norank].> LogicPackage
ResultDisplay .[norank].> LogicPackage
MatchResultView .[norank].> LogicPackage
PersonListPanel .[norank].> Model
PersonListViewCell .[norank].> Model
PersonCard .[norank].> Model
MatchResultView .[norank].> Model

' Multiplicities describe the successfully initialized UI.
' Composition includes containment through JavaFX root nodes.
@enduml
