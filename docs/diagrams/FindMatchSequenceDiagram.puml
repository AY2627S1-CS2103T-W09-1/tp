@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":FindCommandParser" as FindCommandParser LOGIC_COLOR
participant "f:FindMatchCommand" as FindMatchCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "book:ReadOnlyAddressBook" as AddressBook MODEL_COLOR
participant "a:MatchAssessment" as MatchAssessment MODEL_COLOR
end box

note over LogicManager, MatchAssessment
Successful execution is shown. Tokenization, index validation,
comparison getters and preference-counting internals,
LogicManager restore-point/save handling and UI refresh are omitted.
end note

[-> LogicManager : execute("find match/1")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("find match/1")
activate AddressBookParser

create FindCommandParser
AddressBookParser -> FindCommandParser
activate FindCommandParser

FindCommandParser --> AddressBookParser
deactivate FindCommandParser

AddressBookParser -> FindCommandParser : parse(" match/1")
activate FindCommandParser

create FindMatchCommand
FindCommandParser -> FindMatchCommand
activate FindMatchCommand

FindMatchCommand --> FindCommandParser
deactivate FindMatchCommand

FindCommandParser --> AddressBookParser : f
deactivate FindCommandParser

AddressBookParser --> LogicManager : f
deactivate AddressBookParser

LogicManager -> FindMatchCommand : execute(m)
activate FindMatchCommand

FindMatchCommand -> Model : getFilteredPersonList()
activate Model
Model --> FindMatchCommand : displayed list
deactivate Model

note right of FindMatchCommand
target = displayed list[0]
end note

FindMatchCommand -> Model : getAddressBook()
activate Model
Model --> FindMatchCommand : book
deactivate Model
FindMatchCommand -> AddressBook : getPersonList()
activate AddressBook
AddressBook --> FindMatchCommand : all clients
deactivate AddressBook

loop each candidate c in all clients
    opt !c.isSamePerson(target) (skip the source client)
        create MatchAssessment
        FindMatchCommand -> MatchAssessment : new MatchAssessment(target, c)
        activate MatchAssessment
        MatchAssessment --> FindMatchCommand
        deactivate MatchAssessment

        FindMatchCommand -> MatchAssessment : getOutcome()
        activate MatchAssessment
        MatchAssessment --> FindMatchCommand : outcome
        deactivate MatchAssessment

        opt outcome != INCOMPATIBLE
            FindMatchCommand -> FindMatchCommand : countPreferencesMet(assessment)
            note right of FindMatchCommand
            Store the number of MET preferences
            across both directions in scores[c].
            INSUFFICIENT_INFORMATION is retained.
            end note
        end
    end
end

FindMatchCommand -> Model : updateFilteredPersonList(scores::containsKey, comparator)
activate Model
Model --> FindMatchCommand
deactivate Model

note right of FindMatchCommand : comparator sorts by score descending.

FindMatchCommand -> Model : getFilteredPersonList()
activate Model
Model --> FindMatchCommand : ranked matches
deactivate Model

create CommandResult
FindMatchCommand -> CommandResult : new CommandResult(listed-count feedback)
activate CommandResult
CommandResult --> FindMatchCommand
deactivate CommandResult

FindMatchCommand --> LogicManager : r
deactivate FindMatchCommand

[<--LogicManager
deactivate LogicManager
@enduml
